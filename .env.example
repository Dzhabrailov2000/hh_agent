# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-...

# HH.ru аккаунт соискателя (обычный логин на сайте)
HH_LOGIN=your@email.com
HH_PASSWORD=yourpassword

# Telegram-уведомления
# 1. Создайте бота через @BotFather → получите токен
# 2. Напишите боту любое сообщение
# 3. Откройте https://api.telegram.org/bot<TOKEN>/getUpdates → найдите "chat": {"id": ...}
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=123456789
